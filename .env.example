# MongoDB Atlas connection string (add a database name, e.g. /ecoflow)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ecoflow?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Used only by `npm run seed`
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeThisStrongPassword

# --- Waste reports (photo storage) ---
# Production: create a Blob store in Vercel (Project > Storage > Create > Blob). Vercel adds this variable for you.
BLOB_READ_WRITE_TOKEN=
# Local testing ONLY: save photos to public/uploads instead of Vercel Blob. Never set this on Vercel.
LOCAL_UPLOADS=1

# --- Password reset emails (Resend: https://resend.com) ---
# API key from Resend > API Keys. Server-side only, never put it in frontend JS.
RESEND_API_KEY=
# Sender address on a domain you verified in Resend, e.g. "E-arthchakra <no-reply@yourdomain.com>"
# For a quick test before verifying a domain: "E-arthchakra <onboarding@resend.dev>" (only delivers to your own Resend account email)
EMAIL_FROM=
# Local testing ONLY: with no Resend key, print reset emails (including the code) to the terminal. Ignored on Vercel.
EMAIL_DEV_CONSOLE=
